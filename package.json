{
  "name": "liverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts --host 127.0.0.1",
    "build": "pnpm typecheck && pnpm build:api && pnpm build:admin && pnpm build:mini",
    "build:api": "tsc -p apps/api/tsconfig.json && tsx scripts/build-api.ts",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "build:mini": "tsx scripts/build-mini.ts",
    "build:guest": "tsx scripts/build-guest.ts",
    "serve:guest": "vite preview --outDir dist/guest --host 127.0.0.1 --port 4174 --strictPort",
    "test:guest": "playwright test --config playwright.guest.config.ts",
    "build:demo": "npm --prefix apps/demo run build",
    "demo": "npm --prefix apps/demo run preview",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/miniprogram/tsconfig.json",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "tsx scripts/database.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "check": "pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.2.1",
    "@prisma/client": "6.19.0",
    "ajv": "8.20.0",
    "antd": "5.29.1",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "cos-nodejs-sdk-v5": "3.0.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "multer": "2.0.2",
    "otplib": "12.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "three": "0.133.1",
    "three-platformize": "1.133.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.1.1",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.27.0",
    "miniprogram-api-typings": "4.0.8",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
