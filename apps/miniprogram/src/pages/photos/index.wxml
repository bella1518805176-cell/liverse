<view class="page"><view class="row between"><view class="title">现场实拍</view><button bindtap="submit">＋ 投稿</button></view><view class="row"><picker class="grow" range="{{events}}" range-key="name" value="{{eventIndex}}" bindchange="eventChange">{{events[eventIndex].name}}⌄</picker><picker class="grow" range="{{sections}}" range-key="name" value="{{sectionIndex}}" bindchange="sectionChange">{{sections[sectionIndex].name}}⌄</picker></view><view class="tabs"><view class="tab {{kind === 'all' ? 'active' : ''}}" data-kind="all" bindtap="kind">全部</view><view class="tab {{kind === 'text' ? 'active' : ''}}" data-kind="text" bindtap="kind">文字体验</view></view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="retry">重试</button></view><view class="empty" wx:if="{{!items.length && !loading && !error}}">当前条件暂无实拍<button bindtap="home">返回看座</button></view><view class="stack"><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><image wx:if="{{item.image}}" class="photo" src="{{item.image}}" mode="aspectFill"/><view class="gap"/><view class="pill">{{item.source === 'official' ? '官方参考' : '观众分享'}} · {{item.position.kind === 'seat' ? '座位实拍' : item.position.kind === 'section' ? '区域参考' : '场馆参考'}}</view><view class="line">{{item.text}}</view><view class="muted">{{item.displayName}} · {{item.helpfulCount}} 人标记有用</view></view></view><view class="empty" wx:if="{{loading}}">加载中…</view><button wx:if="{{nextCursor}}" bindtap="more">加载更多</button></view>
