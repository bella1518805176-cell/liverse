<view class="page"><view class="empty" wx:if="{{loading}}">加载中…</view><view class="error" wx:if="{{error}}">{{error}}</view><block wx:if="{{content}}"><view class="pill">{{content.source === 'official' ? '官方参考' : '观众分享'}} · {{content.position.kind === 'seat' ? '座位实拍' : content.position.kind === 'section' ? '区域参考' : '场馆参考'}}</view><view class="heading">{{content.displayName}}</view><view class="stack"><image wx:for="{{images}}" wx:key="*this" class="image" mode="aspectFit" src="{{item}}" data-url="{{item}}" bindtap="preview"/></view><view class="line">{{content.text}}</view><view class="tabs"><text class="pill" wx:for="{{content.tags}}" wx:key="*this">{{item}}</text></view><view class="muted">拍摄日期：{{content.shotDate || '未填写'}}<view>场次：{{content.eventId || '未填写'}}</view><view>设备：{{content.device || '未填写'}} · 倍率：{{content.zoom || '未填写'}}</view></view><view class="notice">实拍仅代表当时拍摄条件，不保证其他场次的舞美或人群遮挡相同。</view><button class="primary" bindtap="position">查看关联位置</button><view class="actions"><button bindtap="helpful">{{helpful ? '✓ 已标记有用' : '♡ 有用'}}</button><button bindtap="report">举报</button><button open-type="share">↗ 分享</button></view></block></view>
