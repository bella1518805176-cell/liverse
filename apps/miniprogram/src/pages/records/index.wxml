<view class="page"><view class="title">{{title}}</view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view><view class="empty" wx:if="{{loading}}">加载中…</view><view class="empty" wx:elif="{{!items.length}}">暂无记录</view><view wx:for="{{items}}" wx:key="id" class="line" data-index="{{index}}" bindtap="open"><view class="row between"><text class="grow">{{item.label}}</text><button wx:if="{{type !== 'recent'}}" data-index="{{index}}" catchtap="remove" aria-label="删除记录">×</button></view><view class="pill" wx:if="{{item.state}}">{{item.state}}</view><view class="muted" wx:if="{{item.reason}}">{{item.reason}}</view></view></view>
