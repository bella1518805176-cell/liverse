<view class="hero-wrap"><image class="hero" src="{{image}}" mode="aspectFill"/><view class="hero-copy"><view class="brand">LIVERSE<text class="orange">.</text></view><view>北京 · 音宇宙</view></view></view>
<view class="page"><view class="row between"><text class="title">找到你的现场视角</text><text class="pill">北京</text></view><view class="notice" wx:if="{{development}}">开发示例 · 排座与模型仅供交互验证</view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view><view class="empty" wx:if="{{loading}}">正在获取场馆资料…</view><block wx:elif="{{layout}}"><view class="section"><view class="heading">标准座位布局</view><view class="muted">{{layout.name}}</view><view class="version">更新于 {{layout.updatedAt}} · {{layout.demo ? '开发示例' : '场馆资料'}}</view><button class="primary" bindtap="openMap">进入看座 →</button></view></block><view class="empty" wx:elif="{{!error}}">场馆资料准备中<view class="muted">正式布局发布后即可查看位置。</view></view><view class="row between section" bindtap="photos"><view><view class="heading">从现场，看现场</view><view class="muted">查看实拍与观演体验</view></view><text class="orange">→</text></view><view class="heading" wx:if="{{recent.length}}">最近浏览</view><view class="line" wx:for="{{recent}}" wx:key="path" data-path="{{item.path}}" bindtap="openRecent">{{item.label}} <text class="orange">↗</text></view></view>
