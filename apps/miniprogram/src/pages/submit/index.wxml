<view class="page"><block wx:if="{{success}}"><view class="title">已提交审核</view><view class="muted">审核通过后公开，可在我的投稿查看进度。</view><button class="primary" bindtap="records">查看我的投稿</button></block><block wx:else><view class="title">分享你的现场</view><view class="notice">公开前请检查票务二维码、证件和其他隐私内容。最多 4 张图片，每张不超过 20 MB。</view><view class="field"><text>分享范围</text><picker range="{{scopes}}" value="{{scope}}" data-field="scope" bindchange="picker">{{scopes[scope]}}⌄</picker></view><view class="field" wx:if="{{scope > 0}}"><text>区域</text><picker range="{{sections}}" range-key="name" value="{{sectionIndex}}" data-field="sectionIndex" bindchange="picker">{{sections[sectionIndex].name}}⌄</picker></view><view class="row" wx:if="{{scope === 2}}"><input placeholder="票面排号" value="{{row}}" data-field="row" bindinput="input"/><input placeholder="票面座号" value="{{seat}}" data-field="seat" bindinput="input"/></view><view class="field"><text>场次（选填）</text><picker range="{{events}}" range-key="name" value="{{eventIndex}}" data-field="eventIndex" bindchange="picker">{{events[eventIndex].name}}⌄</picker></view><view class="stack"><view wx:for="{{images}}" wx:key="path" class="card"><image class="photo" src="{{item.path}}" mode="aspectFit"/><view class="row between"><text>{{item.state}}</text><button data-index="{{index}}" bindtap="removeImage" disabled="{{busy}}">移除</button></view></view></view><button wx:if="{{images.length < 4}}" bindtap="choose" disabled="{{busy}}">＋ 添加照片</button><view class="field"><text>现场体验</text><textarea maxlength="300" placeholder="记录你在这个位置的观演感受" value="{{text}}" data-field="text" bindinput="input"/><view class="muted">{{text.length}} / 300</view></view><checkbox-group bindchange="tags"><label wx:for="{{allTags}}" wx:key="*this" class="pill"><checkbox value="{{item}}" color="#ff5018"/>{{item}}</label></checkbox-group><view class="field"><text>公开署名</text><input maxlength="30" placeholder="本次投稿的公开昵称" value="{{displayName}}" data-field="displayName" bindinput="input"/></view><view class="field"><text>设备（选填）</text><input maxlength="80" value="{{device}}" data-field="device" bindinput="input"/></view><view class="field"><text>倍率（选填）</text><input maxlength="30" value="{{zoom}}" data-field="zoom" bindinput="input"/></view><view class="field"><text>拍摄日期（选填，YYYY-MM-DD）</text><input maxlength="10" value="{{shotDate}}" data-field="shotDate" bindinput="input"/></view><checkbox-group bindchange="consent"><label class="check"><checkbox value="yes" checked="{{consent}}" color="#ff5018"/><text>我拥有所提交内容的权利，并同意本次投稿的照片、文字、署名及位置等信息在审核通过后公开展示。</text></label></checkbox-group><view class="error" wx:if="{{error}}">{{error}}</view><view class="gap"/><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交审核</button></block></view>
