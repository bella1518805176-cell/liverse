<view class="page"><view class="title">反馈与举报</view><view class="notice" wx:if="{{contact}}" bindtap="contact">隐私／版权紧急联系：{{contact}}</view><view class="field"><text>问题类型</text><picker range="{{categories}}" value="{{category}}" bindchange="category">{{categories[category]}}⌄</picker></view><view class="field"><text>问题描述</text><textarea maxlength="1000" value="{{text}}" bindinput="input" placeholder="请说明问题及相关位置"/></view><view class="error">{{error}}</view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交反馈</button><view class="heading">我的处理进度</view><view class="empty" wx:if="{{!items.length}}">暂无反馈记录</view><view class="line" wx:for="{{items}}" wx:key="id"><text class="pill">{{item.status === 'received' ? '已收到' : item.status === 'processing' ? '处理中' : item.status === 'resolved' ? '已解决' : '不予处理'}}</text><view class="line">{{item.text}}</view><view class="muted">{{item.reply || '等待运营处理'}}</view></view></view>
