page{background:#0b0d10;color:#f5f6f7;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;letter-spacing:0}view,text,button,input,textarea{box-sizing:border-box}button{border-radius:6px;font-size:28rpx;min-height:88rpx;line-height:88rpx;margin:0;background:#22272e;color:#fff;padding:0 24rpx}button::after{border:0}.page{padding:32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}.brand{font-size:48rpx;font-weight:900}.orange{color:#ff5018}.muted{color:#a5abb3;font-size:24rpx;line-height:1.7}.title{font-size:40rpx;font-weight:700;margin:28rpx 0 16rpx}.heading{font-size:32rpx;font-weight:600;margin:32rpx 0 20rpx}.primary{background:#ff5018;color:#fff;font-weight:600}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.grow{flex:1;min-width:0}.stack{display:flex;flex-direction:column;gap:20rpx}.pill{display:inline-block;padding:8rpx 14rpx;background:#252b31;color:#e8ebee;border-radius:4px;font-size:22rpx}.notice{background:#302218;color:#ffc6a5;border-left:4rpx solid #ff5018;padding:18rpx 22rpx;margin:20rpx 0;font-size:24rpx;line-height:1.6}.empty{padding:72rpx 12rpx;text-align:center;color:#adb4bc;line-height:1.8}.error{color:#ffb6a3;padding:20rpx 0;line-height:1.6}.line{padding:28rpx 0;border-bottom:1rpx solid #2b3036}.image{width:100%;height:390rpx;border-radius:6px}.card{background:#191d22;border:1rpx solid #30353c;border-radius:6px;padding:24rpx}.actions{display:flex;gap:12rpx;margin-top:24rpx;flex-wrap:wrap}.actions button{flex:1;min-width:120rpx}.field{margin:24rpx 0}.field text{display:block;color:#bdc3cb;margin-bottom:14rpx}input,textarea,picker{background:#1c2127;border:1rpx solid #373f49;border-radius:4px;padding:22rpx;color:#fff;min-height:88rpx;width:100%}textarea{height:230rpx}.tabs{display:flex;gap:12rpx;flex-wrap:wrap;margin:24rpx 0}.tab{background:#22272e;padding:18rpx 24rpx;min-height:80rpx;border-radius:4px}.tab.active{background:#ff5018;color:#fff}.photo{width:100%;height:360rpx;border-radius:4px}.small{font-size:22rpx}.gap{height:24rpx}.check{display:flex;align-items:flex-start;gap:14rpx;font-size:24rpx;line-height:1.7}.danger{color:#ffb3a4}.metric{font-size:40rpx;font-weight:700}.hero{width:100%;height:420rpx}.hero-wrap{position:relative}.hero-copy{position:absolute;left:28rpx;bottom:28rpx;text-shadow:0 2px 8px #000}.hero-copy .brand{font-size:54rpx}.section{padding:24rpx 0;border-bottom:1rpx solid #272c33}.link{color:#ff936b}.toolbar{display:flex;gap:10rpx;flex-wrap:wrap}.toolbar button{min-width:88rpx}.version{font-size:22rpx;color:#a2aab3;margin:16rpx 0}
