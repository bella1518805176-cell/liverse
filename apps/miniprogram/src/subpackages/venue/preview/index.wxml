<view class="page"><view class="title">{{label || '位置视野'}}</view><view class="notice" wx:if="{{demo}}">开发示例 · 模型尺寸、座位及遮挡不代表真实场馆</view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="map">返回看座</button></view><view wx:if="{{loading}}" class="empty">加载中…</view><block wx:if="{{!loading && !error}}"><view class="tabs"><view wx:if="{{canModel}}" class="tab {{mode === 'model' ? 'active' : ''}}" bindtap="model">模型模拟</view><view class="tab {{mode === 'reference' ? 'active' : ''}}" bindtap="reference">参考资料</view></view><block wx:if="{{mode === 'model'}}"><canvas id="scene" type="webgl" class="scene" bindtouchstart="start" catchtouchmove="move" bindtouchend="end" bindwebglcontextlost="contextLost"/><view class="error" wx:if="{{renderError}}">{{renderError}}<button bindtap="retry">重试</button><button bindtap="reference">查看参考资料</button></view><view class="toolbar"><button bindtap="reset" aria-label="复位视角">⟲</button><button bindtap="overview">总览</button><button bindtap="screenshot" aria-label="截图">▣</button></view><view class="row between line"><text>站姿模拟</text><switch checked="{{standing}}" color="#FF5018" bindchange="stance"/></view></block><block wx:else><image wx:if="{{referenceImage}}" class="image" mode="aspectFit" src="{{referenceImage}}"/><view class="notice" wx:if="{{referenceImage}}">场馆宣传资料第 15 页 · 未校准位置，不能视为所选座位实拍</view><view class="empty" wx:else>当前位置暂无已核验参考资料</view><button bindtap="photos">查看已公开实拍</button></block><view class="heading">{{label}}</view><view class="muted">{{version}}<view>{{source}}</view></view><view class="actions"><button bindtap="favorite">{{favorite ? '★ 已收藏' : '☆ 收藏'}}</button><button bindtap="compare">＋ 对比</button><button open-type="share">↗ 分享</button></view><view class="gap"/><button bindtap="map">返回座位图</button></block></view>
