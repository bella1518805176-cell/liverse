.map-page{height:100vh;display:flex;flex-direction:column;overflow:hidden}.map-header{padding:0 24rpx 16rpx}.map-header .heading{margin:16rpx 0}.map-header .tabs{margin:12rpx 0}.search{margin-top:12rpx}.search input{min-width:0;flex:1}.search button{flex-shrink:0}.map{flex:1;width:100%;min-height:240rpx}.map-tools{position:absolute;right:20rpx;top:48%;display:flex;flex-direction:column;gap:10rpx}.map-tools button{width:88rpx;padding:0}.map-bottom{background:#1a1f25;border-top:1rpx solid #343b44;padding:20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom))}.map-bottom .heading{margin:12rpx 0}
