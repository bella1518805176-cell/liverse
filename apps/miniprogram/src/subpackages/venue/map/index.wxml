<view class="map-page"><view class="map-header"><view class="row between"><text class="heading">北京 LIVERSE</text><text class="pill">{{demo ? '开发示例' : '标准布局'}}</text></view><view class="tabs"><view wx:for="{{floors}}" wx:key="*this" class="tab {{floor === item ? 'active' : ''}}" data-floor="{{item}}" bindtap="floor">{{item}}</view></view><view class="row" wx:if="{{sections.length}}"><picker class="grow" range="{{sections}}" range-key="name" value="{{sectionIndex}}" bindchange="section">{{sections[sectionIndex].name}}⌄</picker></view><view class="row search" wx:if="{{hasSeats}}"><input placeholder="排，如 D01" value="{{row}}" data-field="row" bindinput="input"/><input placeholder="号，如 01" value="{{seat}}" data-field="seat" bindinput="input"/><button bindtap="search">查找</button></view></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="empty" wx:if="{{loading}}">正在加载地图…</view><canvas wx:if="{{!loading && !error}}" id="map" type="2d" class="map" bindtouchstart="start" catchtouchmove="move" bindtouchend="end"/><view class="map-tools"><button data-factor="1.3" bindtap="zoom" aria-label="放大">＋</button><button data-factor="0.77" bindtap="zoom" aria-label="缩小">－</button><button bindtap="reset" aria-label="复位">⟲</button></view><view class="map-bottom"><view class="row between"><text class="muted">{{zoom}}× · {{version}}</text><button bindtap="openCompare">对比 {{compareCount}}/2</button></view><block wx:if="{{selected}}"><view class="heading">{{selectedLabel}}</view><text class="muted">{{demo ? '开发示例 · 非正式排座' : '标准场馆资料'}}</text><view class="actions"><button class="primary" bindtap="preview">查看视野</button><button bindtap="favorite">☆ 收藏</button><button bindtap="compare">＋ 对比</button></view></block><view wx:else class="muted">{{hasSeats ? '选择地图中的位置' : '选择区域，查看已有参考资料'}}</view></view></view>
