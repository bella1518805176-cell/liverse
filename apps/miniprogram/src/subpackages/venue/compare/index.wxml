<view class="page"><view class="title">位置对比</view><view class="notice">{{items.length === 2 ? '模型预览采用相同画幅、视场角与眼高基准。照片拍摄条件不同，分别浏览。' : '选择两个同版本位置开始对比'}}</view><view class="stack"><view wx:for="{{items}}" wx:key="path" class="card" data-index="{{index}}" bindtap="select"><view class="row between"><text class="pill">{{index === 0 ? 'A' : 'B'}} {{active === index ? '· 当前' : ''}}</text><button data-index="{{index}}" catchtap="remove" aria-label="移除位置">×</button></view><view class="heading">{{item.label}}</view><text class="muted">同一布局版本 · 开始预览时恢复基准</text></view></view><view class="actions"><button class="primary" bindtap="open" disabled="{{!items.length}}">查看{{active === 0 ? ' A' : ' B'}}视野</button><button bindtap="map">{{items.length === 2 ? '替换位置' : '继续选位'}}</button></view></view>
